# Copia este archivo como .env y completa los valores.
# Si VITE_API_URL queda vacío, la app funciona en MODO PRUEBA (datos guardados solo en tu navegador).

# Dirección de tu API (carpeta server/).
#  · En tu computadora:  http://localhost:3001
#  · En producción:      https://api.woditek.com
VITE_API_URL=

# Tu dominio. Con esto cada negocio queda en negocio.tudominio.com (ver LEEME.md).
# Déjalo vacío para usar links tipo tudominio.com/?c=negocio
VITE_BASE_DOMAIN=
