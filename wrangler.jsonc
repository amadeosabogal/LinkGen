{
  // Despliegue en Cloudflare Workers (ver LEEME.md, paso 3).
  // Cambia "woditek.com" si usas otro dominio.
  "name": "linkgen",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Cualquier negocio.woditek.com llega a LinkGen. No incluye el dominio principal (woditek.com).
  "routes": [{ "pattern": "*.woditek.com/*", "zone_name": "woditek.com" }]
}
