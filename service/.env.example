# Copia este archivo como .env y completa los valores. NUNCA subas el .env a GitHub.

SQLSERVER_USER=
SQLSERVER_PASSWORD=
# host o host:puerto
SQLSERVER_SERVER=
SQLSERVER_DATABASE=LinkGen
# pon false solo si tu SQL Server no soporta conexión cifrada
SQLSERVER_ENCRYPT=true

# Clave secreta para las sesiones del panel (mínimo 32 caracteres, aleatoria)
JWT_SECRET=
PORT=3001
